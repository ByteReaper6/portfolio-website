# Copy this file to .env and fill in your real values

# ── Local Docker dev (docker compose up) ──────────────────────────────────────
# MongoDB runs as a container; use the service name "mongo" as the host
MONGODB_URI=mongodb://mongo:27017/portfolio

# ── MongoDB Atlas (Vercel / production deploy) ────────────────────────────────
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

PORT=5000

# Admin token for accessing GET /api/messages and POST /api/projects
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your-secret-admin-token-here

# ── Telegram Bot Notification ─────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your personal Telegram chat ID (message @userinfobot to find it)
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
